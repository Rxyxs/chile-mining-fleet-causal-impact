venv/
__pycache__/
*.pyc
.pytest_cache/
.ipynb_checkpoints/
.env
.DS_Store

# Datos sinteticos (se regeneran con `python -m src.pipeline`)
data/raw/*.csv
!data/raw/.gitkeep

# Artefactos del pipeline que se regeneran (las figuras SI quedan versionadas)
outputs/reports/*
!outputs/reports/.gitkeep
!outputs/figures/*.png
!outputs/figures/*.gif

# Interactive Plotly dashboard: embeds the full Plotly.js bundle inline (~4-5MB),
# which was making GitHub misdetect the repo's primary language as HTML instead
# of the real code. Regenerate locally from its source script.
outputs/interactive/
