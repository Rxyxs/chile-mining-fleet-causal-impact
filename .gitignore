venv/
__pycache__/
*.pyc
.pytest_cache/
.ipynb_checkpoints/
.env
.DS_Store

# Datos sinteticos (se regeneran con `python -m src.pipeline`) y datos reales
# de UCI (se descargan con `python -m src.data.download_real_data`)
data/raw/*.csv
data/raw/*.zip
data/raw/*.txt
!data/raw/.gitkeep

# Artefactos del pipeline que se regeneran (las figuras SI quedan versionadas)
outputs/reports/*
!outputs/reports/.gitkeep
!outputs/reports/semi_synthetic_results.md
!outputs/figures/*.png
!outputs/figures/*.gif

# Interactive Plotly dashboard: embeds the full Plotly.js bundle inline (~4-5MB),
# which was making GitHub misdetect the repo's primary language as HTML instead
# of the real code. Regenerate locally from its source script.
outputs/interactive/
